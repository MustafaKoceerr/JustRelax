import com.mustafakoceerr.justrelax.core.model.soundscape.EventFrequency;

CREATE TABLE saved_scene (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

-- frequency is null for a bed. A deleted sound simply drops out of the scenes that used it.
CREATE TABLE saved_scene_layer (
    scene_id INTEGER NOT NULL REFERENCES saved_scene(id) ON DELETE CASCADE,
    sound_id TEXT NOT NULL REFERENCES sound(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    volume REAL NOT NULL,
    frequency TEXT AS EventFrequency,
    PRIMARY KEY (scene_id, sound_id)
);

CREATE INDEX saved_scene_layer_sound_id ON saved_scene_layer(sound_id);

insertScene:
INSERT INTO saved_scene(name, created_at) VALUES (?, ?);

insertLayer:
INSERT INTO saved_scene_layer(scene_id, sound_id, position, volume, frequency) VALUES (?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

selectAllScenes:
SELECT * FROM saved_scene ORDER BY created_at DESC, id DESC;

selectAllLayers:
SELECT * FROM saved_scene_layer ORDER BY scene_id, position;

deleteSceneById:
DELETE FROM saved_scene WHERE id = ?;
