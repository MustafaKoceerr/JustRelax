    "support_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, kein Abo. Wenn dir die App beim Entspannen hilft, hält ein kleines Trinkgeld sie am Laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ads and no subscription. If it helps you rest, a small tip keeps it going."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios ni suscripción. Si te ayuda a descansar, una pequeña propina lo mantiene vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans publicité ni abonnement. Si elle vous aide à vous reposer, un petit pourboire la fait vivre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न विज्ञापन, न सदस्यता। अगर यह आपको आराम देता है, तो एक छोटी टिप इसे चलाए रखती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente pubblicità né abbonamenti. Se ti aiuta a riposare, una piccola mancia la tiene in vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告もサブスクリプションもありません。休息の助けになっているなら、少しのチップが開発を支えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고도 구독도 없습니다. 휴식에 도움이 된다면 작은 팁이 앱을 계속 이어가게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen advertenties en geen abonnement. Helpt het je ontspannen, dan houdt een kleine fooi het draaiende."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem anúncios nem assinatura. Se ele ajuda você a descansar, uma pequena gorjeta o mantém vivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen reklam och ingen prenumeration. Hjälper appen dig att vila håller en liten dricks den vid liv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklam yok, abonelik yok. Dinlenmene yardımcı oluyorsa küçük bir bahşiş uygulamanın sürmesini sağlar."
          }
        }
      }
    },
