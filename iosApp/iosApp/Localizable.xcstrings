          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe um arquivo de áudio, fique com a parte de que gosta e ela entra na sua biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera en ljudfil, behåll den del du gillar så hamnar den i ditt bibliotek."
