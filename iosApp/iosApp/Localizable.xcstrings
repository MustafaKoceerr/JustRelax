    "mysounds_delete_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wird aus deiner Bibliothek und deinen gespeicherten Mixes entfernt."
          }
        },
