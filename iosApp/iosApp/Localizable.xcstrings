    "consent_point_never" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie enthalten: alles, was du eingibst, suchst oder importierst. Deine Klänge bleiben auf deinem Telefon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never included: anything you type, search or import. Your sounds stay on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se incluye: nada de lo que escribes, buscas o importas. Tus sonidos se quedan en tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais inclus : ce que vous tapez, cherchez ou importez. Vos sons restent sur votre téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी शामिल नहीं: जो भी आप लिखते, खोजते या इम्पोर्ट करते हैं। आपकी आवाज़ें आपके फ़ोन पर ही रहती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai incluso: ciò che scrivi, cerchi o importi. I tuoi suoni restano sul telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含まれないもの：入力・検索・インポートした内容。あなたの音は端末に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포함되지 않음: 입력하거나 검색하거나 가져온 내용. 내 소리는 휴대폰에만 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nooit inbegrepen: wat je typt, zoekt of importeert. Je geluiden blijven op je telefoon."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca incluído: nada do que você digita, pesquisa ou importa. Seus sons ficam no seu celular."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingår aldrig: det du skriver, söker eller importerar. Dina ljud stannar på din telefon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla içermez: yazdığın, aradığın ya da içe aktardığın hiçbir şey. Seslerin telefonunda kalır."
          }
        }
      }
    },
    "consent_point_sent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deiner Erlaubnis gesendet: anonyme Nutzungsstatistiken, etwa welche Bildschirme genutzt werden, und Absturzberichte über Google Firebase."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent with your permission: anonymous usage statistics, such as which screens are used, and crash reports, through Google Firebase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía con tu permiso: estadísticas de uso anónimas, como qué pantallas se usan, e informes de fallos, a través de Google Firebase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé avec votre accord : des statistiques d’utilisation anonymes, comme les écrans utilisés, et des rapports de plantage, via Google Firebase."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अनुमति से भेजा जाता है: गुमनाम उपयोग आँकड़े, जैसे कौन-सी स्क्रीन इस्तेमाल होती हैं, और क्रैश रिपोर्ट, Google Firebase के ज़रिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato con il tuo permesso: statistiche d’uso anonime, come le schermate usate, e rapporti sugli arresti anomali, tramite Google Firebase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可した場合に送信：どの画面が使われたかなどの匿名の利用統計とクラッシュレポート（Google Firebase 経由）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허락하면 전송: 어떤 화면을 쓰는지 같은 익명 사용 통계와 오류 보고서(Google Firebase를 통해)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met je toestemming verstuurd: anonieme gebruiksstatistieken, zoals welke schermen worden gebruikt, en crashrapporten, via Google Firebase."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado com sua permissão: estatísticas de uso anônimas, como quais telas são usadas, e relatórios de falhas, pelo Google Firebase."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas med ditt tillstånd: anonym användningsstatistik, till exempel vilka skärmar som används, och kraschrapporter, via Google Firebase."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verirsen gönderilir: hangi ekranların kullanıldığı gibi anonim kullanım istatistikleri ve çökme raporları, Google Firebase üzerinden."
          }
        }
      }
    },
