    "support_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Trinkgeld ist eine einmalige Zahlung über den Store. Es schaltet nichts frei; die App bleibt für alle gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tip is a one-time payment through the store. It unlocks nothing; the app stays the same for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una propina es un pago único a través de la tienda. No desbloquea nada; la app es igual para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pourboire est un paiement unique via la boutique. Il ne débloque rien ; l’app reste la même pour tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टिप स्टोर के ज़रिए एक बार का भुगतान है। इससे कुछ भी अनलॉक नहीं होता; ऐप सबके लिए एक जैसा रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mancia è un pagamento unico tramite lo store. Non sblocca nulla; l’app resta uguale per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チップはストアを通じた1回限りの支払いです。何も解除されず、アプリは誰にとっても同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁은 스토어를 통한 일회성 결제입니다. 잠금 해제되는 기능은 없으며 앱은 모두에게 똑같습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een fooi is een eenmalige betaling via de store. Er wordt niets mee ontgrendeld; de app blijft voor iedereen hetzelfde."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gorjeta é um pagamento único pela loja. Ela não desbloqueia nada; o app continua igual para todos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dricks är en engångsbetalning via butiken. Den låser inte upp något; appen är densamma för alla."
          }
        },
        "tr" : {
          "stringUnit" : {
