    "mysounds_empty_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere eine Audiodatei, behalte den Teil, der dir gefällt, und er landet in deiner Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import an audio file, keep the part you like and it joins your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un archivo de audio, quédate con la parte que te guste y se añadirá a tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un fichier audio, gardez la partie qui vous plaît et elle rejoint votre bibliothèque."
