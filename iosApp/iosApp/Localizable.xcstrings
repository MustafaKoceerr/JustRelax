    "ai_greeting_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe einen Ort, einen Moment oder ein Gefühl – daraus entsteht eine Szene aus deinen geladenen Klängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe a place, a moment or a feeling, and a scene is built from your downloaded sounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe un lugar, un momento o una sensación y se creará una escena con tus sonidos descargados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez un lieu, un moment ou une sensation : une scène est créée avec vos sons téléchargés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई जगह, पल या एहसास बताइए, और आपकी डाउनलोड की गई आवाज़ों से एक दृश्य बनेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi un luogo, un momento o una sensazione: verrà creata una scena con i tuoi suoni scaricati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所や瞬間、気分を書いてください。ダウンロード済みの音でシーンを作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소나 순간, 느낌을 적어 보세요. 다운로드한 소리로 장면을 만들어 드려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf een plek, een moment of een gevoel, en er ontstaat een scène met je gedownloade geluiden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva um lugar, um momento ou uma sensação e uma cena será criada com seus sons baixados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv en plats, ett ögonblick eller en känsla, så skapas en scen av dina nedladdade ljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yer, bir an ya da bir his anlat; indirdiğin seslerden bir sahne kurulsun."
          }
        }
      }
    },
