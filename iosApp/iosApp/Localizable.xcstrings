    "saved_empty_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefällt dir eine Szene? Speichere sie, während sie läuft – hier wartet sie dann auf dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
