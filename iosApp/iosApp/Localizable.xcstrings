        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई ऑडियो फ़ाइल इम्पोर्ट करें, पसंद का हिस्सा रखें और वह आपकी लाइब्रेरी में जुड़ जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un file audio, tieni la parte che ti piace ed entrerà nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声ファイルを読み込み、気に入った部分を残すとライブラリに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 파일을 가져와 마음에 드는 부분만 남기면 라이브러리에 추가돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
