    "freesound_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde kostenlose Sounds von Freesound.org. Es werden nur Sounds gezeigt, die du nutzen darfst; ihre Urheber werden in der App genannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find free sounds shared on Freesound.org. Only sounds you may use are shown; their authors are credited in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra sonidos gratuitos compartidos en Freesound.org. Solo se muestran los que puedes usar; sus autores aparecen en los créditos de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez des sons gratuits partagés sur Freesound.org. Seuls les sons que vous pouvez utiliser sont affichés ; leurs auteurs sont crédités dans l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freesound.org पर साझा की गई मुफ़्त ध्वनियाँ खोजें। केवल वही ध्वनियाँ दिखती हैं जिनका आप उपयोग कर सकते हैं; उनके रचनाकारों को ऐप में श्रेय दिया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova suoni gratuiti condivisi su Freesound.org. Vengono mostrati solo i suoni che puoi usare; gli autori sono citati nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freesound.org で共有されている無料のサウンドを探せます。使用できるサウンドだけが表示され、作者はアプリ内でクレジットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freesound.org에 공유된 무료 사운드를 찾아보세요. 사용할 수 있는 사운드만 표시되며, 제작자는 앱에 표기돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind gratis geluiden die op Freesound.org zijn gedeeld. Alleen geluiden die je mag gebruiken worden getoond; de makers worden in de app vermeld."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre sons gratuitos compartilhados no Freesound.org. Só aparecem sons que você pode usar; os autores são creditados no app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta gratis ljud som delats på Freesound.org. Bara ljud du får använda visas; upphovspersonerna anges i appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freesound.org’da paylaşılan ücretsiz sesleri bul. Yalnızca kullanabileceğin sesler gösterilir; sahipleri uygulamada anılır."
          }
        }
      }
    },
