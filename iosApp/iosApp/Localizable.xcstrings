    "ai_data_notice_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Mix werden dein Text und die Namen deiner heruntergeladenen Sounds an OpenAI gesendet. OpenAI kann sie speichern und zur Verbesserung seiner Modelle nutzen. Bitte gib keine persönlichen Daten ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To create a mix, what you write and the names of your downloaded sounds are sent to OpenAI. OpenAI may keep them and use them to improve its models. Please don’t include personal information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para crear una mezcla, lo que escribes y los nombres de tus sonidos descargados se envían a OpenAI. OpenAI puede conservarlos y usarlos para mejorar sus modelos. No incluyas información personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour créer un mix, ce que vous écrivez et les noms de vos sons téléchargés sont envoyés à OpenAI. OpenAI peut les conserver et les utiliser pour améliorer ses modèles. N’y mettez pas d’informations personnelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिक्स बनाने के लिए आपका लिखा पाठ और डाउनलोड की गई ध्वनियों के नाम OpenAI को भेजे जाते हैं। OpenAI इन्हें रख सकता है और अपने मॉडल बेहतर बनाने के लिए उपयोग कर सकता है। कृपया व्यक्तिगत जानकारी न लिखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per creare un mix, ciò che scrivi e i nomi dei suoni scaricati vengono inviati a OpenAI. OpenAI può conservarli e usarli per migliorare i propri modelli. Non inserire informazioni personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミックスを作成するため、入力した文章とダウンロード済みサウンドの名前が OpenAI に送信されます。OpenAI はこれらを保存し、モデルの改善に使用する場合があります。個人情報は入力しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믹스를 만들기 위해 입력한 글과 다운로드한 사운드의 이름이 OpenAI로 전송됩니다. OpenAI는 이를 보관하고 모델 개선에 사용할 수 있습니다. 개인정보는 입력하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een mix worden wat je schrijft en de namen van je gedownloade geluiden naar OpenAI gestuurd. OpenAI kan ze bewaren en gebruiken om zijn modellen te verbeteren. Zet er geen persoonsgegevens in."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para criar uma mixagem, o que você escreve e os nomes dos sons baixados são enviados à OpenAI. A OpenAI pode guardá-los e usá-los para melhorar seus modelos. Não inclua informações pessoais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att skapa en mix skickas det du skriver och namnen på dina nedladdade ljud till OpenAI. OpenAI kan spara dem och använda dem för att förbättra sina modeller. Skriv inga personuppgifter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karışım oluşturmak için yazdıklarınız ve indirdiğiniz seslerin adları OpenAI’a gönderilir. OpenAI bunları saklayabilir ve modellerini geliştirmek için kullanabilir. Lütfen kişisel bilgi yazmayın."
          }
        }
      }
    },
