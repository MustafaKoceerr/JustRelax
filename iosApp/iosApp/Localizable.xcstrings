    "mixer_empty_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Anzahl der Klänge und mische. Sperre die, die dir gefallen – sie bleiben beim nächsten Mischen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick how many sounds, then shuffle. Lock the ones you like and they stay when you shuffle again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuántos sonidos y mezcla. Bloquea los que te gusten y se quedarán al volver a mezclar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le nombre de sons, puis mélangez. Verrouillez ceux que vous aimez : ils restent au prochain mélange."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ों की संख्या चुनें और मिलाएँ। पसंद आने वाली आवाज़ों को लॉक करें, दोबारा मिलाने पर वे बनी रहेंगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quanti suoni e mescola. Blocca quelli che ti piacciono: restano quando mescoli di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音の数を選んでシャッフル。気に入った音はロックすると、次のシャッフルでも残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리 개수를 고르고 섞어 보세요. 마음에 드는 소리는 잠그면 다시 섞어도 그대로 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoeveel geluiden en schud. Vergrendel de geluiden die je mooi vindt; die blijven als je opnieuw schudt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quantos sons e misture. Trave os que você gostar e eles ficam quando misturar de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj hur många ljud och blanda. Lås de du gillar så stannar de när du blandar igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaç ses istediğini seç ve karıştır. Beğendiklerini kilitle, yeniden karıştırınca yerinde kalsın."
          }
        }
      }
    },
