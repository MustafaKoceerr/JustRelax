// Your Apple Developer Team ID (developer.apple.com → Membership). Simulator builds need none.
TEAM_ID=

PRODUCT_NAME=JustRelax
PRODUCT_BUNDLE_IDENTIFIER=com.mustafakoceerr.justrelax

// Keep in step with the Android versionName.
MARKETING_VERSION=3.0.0
CURRENT_PROJECT_VERSION=1

// App Attest: builds run from Xcode use Apple's development environment; TestFlight and the
// App Store always use production, whatever this says.
APP_ATTEST_ENV[config=Debug]=development
APP_ATTEST_ENV[config=Release]=production
