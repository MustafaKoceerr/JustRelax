<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JustRelax" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Shown until Compose draws; light or dark with the system theme. -->
        <item name="android:windowBackground">@color/window_background</item>

        <!-- Transparent so Compose draws behind the status bar. -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Status bar icons that stay readable on that background. -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowAnimationStyle">@style/WindowFadeAnimation</item>
    </style>
</resources>